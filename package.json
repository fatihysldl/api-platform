{
  "name": "company-api-platform",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "sync:zoho": "node scripts/sync-zoho.mjs",
    "validate": "npx @redocly/cli lint openapi/openapi.yaml",
    "validate:zoho": "node scripts/validate-zoho.mjs",
    "swagger:config": "node scripts/generate-swagger-config.mjs",
    "postman": "node scripts/generate-postman.mjs",
    "postman:internal": "openapi2postmanv2 -s openapi/openapi.yaml -o generated/postman/company-api.postman_collection.json -p",
    "sdk:typescript": "openapi-generator-cli generate -i openapi/openapi.yaml -g typescript-axios -o generated/sdk/typescript",
    "sdk:csharp": "openapi-generator-cli generate -i openapi/openapi.yaml -g csharp -o generated/sdk/csharp",
    "sdk:zoho:record:typescript": "openapi-generator-cli generate -i zoho/crm/v8.0/record.json -g typescript-axios -o generated/sdk/zoho-record-typescript",
    "generate": "npm run validate && npm run sync:zoho && npm run validate:zoho && npm run swagger:config && npm run postman",
    "docs": "npm run swagger:config && docker compose up swagger-ui",
    "docs:refresh": "npm run sync:zoho && npm run docs",
    "import:postman": "node scripts/import-postman.mjs"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@redocly/cli": "^1.25.5",
    "openapi-to-postmanv2": "^6.3.2",
    "postman-to-openapi": "^1.7.3"
  }
}
